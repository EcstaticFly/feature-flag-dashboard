# Copy to .env.local (git-ignored). Values match the local docker-compose stack.

# ---- read by the browser app (Vite inlines VITE_* into the bundle) ----------
VITE_FLAGPILOT_API_URL=http://localhost:4000
# Public by design: the flag service's CLIENT_API_KEY.
VITE_FLAGPILOT_CLIENT_KEY=dev-only-client-key-public

# ---- read only by server.mjs, never by the browser --------------------------
# SECRET. Deliberately NOT prefixed VITE_: Vite would put it in the bundle.
FLAGPILOT_SDK_KEY=dev-only-sdk-api-key-change-me
FLAGPILOT_API_URL=http://localhost:4000
