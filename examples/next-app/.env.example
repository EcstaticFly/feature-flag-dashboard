# Copy to .env.local (git-ignored) and fill in. Values below match the local
# docker-compose stack (npm run compose:up from the repo root).

# Where this app's server and its visitors' browsers reach the flag service.
FLAGPILOT_API_URL=http://localhost:4000

# SECRET. The flag service's SDK_API_KEY. Read only on the server, in
# lib/flagpilot.server.ts — never prefix it NEXT_PUBLIC_.
FLAGPILOT_SDK_KEY=dev-only-sdk-api-key-change-me

# Public. The flag service's CLIENT_API_KEY; it ships to browsers by design.
FLAGPILOT_CLIENT_KEY=dev-only-client-key-public

# Optional. How often the server SDK refreshes, in ms (default 30000).
# FLAGPILOT_REFRESH_MS=30000
