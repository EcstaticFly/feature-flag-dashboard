# Copy to `.env` (in this same directory) to run the Docker stack on real secrets.
#
#   cp .env.example .env    # then fill in the values below
#
# Docker Compose reads `.env` from the directory holding docker-compose.yml
# automatically, and substitutes it into every ${VAR:-default} there. So you
# never edit docker-compose.yml to set a secret — that file is committed, and
# anything written into it directly would be published. `.env` is gitignored.
#
# THIS IS NOT packages/api/.env. That one is read by dotenv, and only when the
# API runs on the host (`npm run dev`, `npm run db:seed`); Compose never looks at
# it. Running both ways means maintaining both files.
#
# Anything left unset here falls back to the public development default in
# docker-compose.yml, which is why a clean clone works with no setup at all.

# --- credentials -------------------------------------------------------------
# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SDK_API_KEY=
INTEGRATION_API_KEY=

# The single admin account the `seed` service creates. The seed upserts, so
# changing ADMIN_PASSWORD here and re-running `docker compose up` rotates it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false once the four values above are real, and this stack will refuse to
# start on any leftover placeholder — which catches setting two of three secrets.
# Leave it unset (or true) for a throwaway local stack.
ALLOW_DEV_CREDENTIALS=

# --- browser SDKs (flagpilot/browser, flagpilot/react) -----------------------
# The client key is PUBLIC by design — it ships in your pages' JavaScript — but
# generate your own anyway, and never reuse one of the secrets above (the API
# refuses to start if you do). Left empty, these fall back to the development
# defaults in docker-compose.yml, like everything else in this file.
CLIENT_API_KEY=
# Exact origins allowed to use it, comma-separated, e.g.
#   https://app.example.com,http://localhost:5173
# `*` alone means any site. Wildcard subdomains and `null` are refused.
CLIENT_ALLOWED_ORIGINS=
# true (the default): a signed-in user's identity must be a token from your
# server's signContext(), so a visitor cannot claim to be someone else.
CLIENT_REQUIRE_SIGNED_CONTEXT=

# --- tuning (optional) -------------------------------------------------------
# Documented in the README's "Environment variables" table.
JWT_EXPIRES_IN_SECONDS=
FLAG_CACHE_TTL_SECONDS=
FLAG_FALLBACK_POLICY=
FLAG_EVAL_LOG_SAMPLE_RATE=
