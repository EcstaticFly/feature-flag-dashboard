{
  "name": "flagpilot",
  "version": "0.1.0",
  "description": "Server-side client SDK for the feature flag dashboard: local evaluation, no network call per check",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "rollout",
    "sdk"
  ],
  "author": "Suyash Pandey (https://github.com/EcstaticFly)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@feature-flags/core": "*",
    "@types/node": "^22.19.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EcstaticFly/feature-flag-dashboard.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/EcstaticFly/feature-flag-dashboard/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/EcstaticFly/feature-flag-dashboard/issues"
  }
}
