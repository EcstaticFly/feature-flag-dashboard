# Copy to packages/api/.env for local development (values match docker-compose.yml).
# dotenv reads from the working directory, and workspace scripts run inside
# packages/api/, so the file must live here — not at the repo root.
PORT=4000
# Postgres is published on host port 5433 (see docker-compose.yml) to avoid
# clashing with a locally installed Postgres on the default 5432.
DATABASE_URL=postgres://flags:flags@localhost:5433/flags
REDIS_URL=redis://localhost:6379
