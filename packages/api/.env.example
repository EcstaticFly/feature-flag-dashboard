# Copy to packages/api/.env for local development (values match docker-compose.yml).
# dotenv reads from the working directory, and workspace scripts run inside
# packages/api/, so the file must live here — not at the repo root.
PORT=4000
# Postgres is published on host port 5433 (see docker-compose.yml) to avoid
# clashing with a locally installed Postgres on the default 5432.
DATABASE_URL=postgres://flags:flags@localhost:5433/flags
REDIS_URL=redis://localhost:6379

# The three credentials below are PUBLIC placeholders: this file is committed.
# The API refuses to start on any of them unless ALLOW_DEV_CREDENTIALS=true, so a
# deployment cannot inherit them by accident. Replace them and delete this line.
ALLOW_DEV_CREDENTIALS=true

# Signs admin session tokens. At least 32 characters; generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600

# Read-only credential the client SDK sends as `x-api-key`. At least 16 chars.
# Never grants writes — flag CRUD requires the admin JWT.
SDK_API_KEY=dev-only-sdk-api-key-change-me

# Held by the error-tracking service so it can disable a flag in response to an
# alert — and nothing else. Sent as `x-integration-key`.
INTEGRATION_API_KEY=dev-only-integration-key-change-me

# Cache TTL on both tiers (in-process and Redis). Also the safety net for a
# pub/sub invalidation that never arrives: an instance is stale at most this long.
FLAG_CACHE_TTL_SECONDS=30

# What evaluation returns when NO source (Redis or Postgres) can be reached.
# fail-closed -> false, so users keep the behaviour the app had before the flag
# existed. fail-open -> true. See README, "Caching and degradation".
FLAG_FALLBACK_POLICY=fail-closed

# Used by `npm run db:seed` only (not read by the running API).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Fraction of evaluations that emit the structured log line (0-1). Default 1 =
# log every evaluation. Turn it down under heavy load; see the README's
# Performance section for what it costs.
FLAG_EVAL_LOG_SAMPLE_RATE=1
